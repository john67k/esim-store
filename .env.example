# Copy to .env for local use (never commit .env). On Render, set these under Environment.
STORE_NAME=SimNow
SUPPORT_EMAIL=support@example.com
ADMIN_PASSWORD=change-me

# Leave STRIPE_SECRET_KEY empty to stay in TEST MODE (simulated payments).
# When you paste a real Stripe secret key, the store switches to Stripe Checkout automatically.
STRIPE_SECRET_KEY=
# From Stripe: Developers > Webhooks > your endpoint > Signing secret
STRIPE_WEBHOOK_SECRET=
# Public site URL used in Stripe success/cancel links (optional; defaults to the incoming request host)
# PUBLIC_URL=https://esim-store-qyu9.onrender.com

# Kept for a future supplier API. Activations are done by hand in /admin for now.
SUPPLIER=mock
# SUPPLIER_API_URL=
# SUPPLIER_API_KEY=
